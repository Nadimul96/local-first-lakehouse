# Every variable is optional. With none set, `uv run lakehouse demo` runs fully offline:
# a local directory stands in for S3 and keys are generated under the data root.

# --- Data root ---------------------------------------------------------------
# LAKEHOUSE_HOME=.lakehouse                 # where the log, lake, keys and state live

# --- Object storage ----------------------------------------------------------
# LAKEHOUSE_STORE=filesystem                # filesystem (default) or s3
# LAKEHOUSE_S3_BUCKET=lakehouse             # required when LAKEHOUSE_STORE=s3
# LAKEHOUSE_S3_ENDPOINT=http://localhost:9000   # MinIO / R2 endpoint; unset for AWS
# LAKEHOUSE_S3_REGION=us-east-1
# LAKEHOUSE_S3_PREFIX=lakehouse             # key prefix inside the bucket
# LAKEHOUSE_S3_PATH_STYLE=true              # needed for MinIO
# AWS_ACCESS_KEY_ID=                        # or any boto3 credential source
# AWS_SECRET_ACCESS_KEY=

# --- Encryption keys ---------------------------------------------------------
# LAKEHOUSE_KEY_PROVIDER=file               # file (default), env, or keychain (macOS)
# LAKEHOUSE_DATA_KEY_ID=                    # env provider: id of the current key
# LAKEHOUSE_DATA_KEY_B64=                   # env provider: base64 of 32 random bytes
# LAKEHOUSE_DATA_KEYS_RETIRED=              # env provider: id:base64,id:base64 for old objects
# LAKEHOUSE_REDACTION_KEY_B64=              # optional override of the per-install HMAC key

# --- Catalog -----------------------------------------------------------------
# LAKEHOUSE_CATALOG_DSN=                    # Postgres DSN for the SELECT/INSERT role; unset = SQLite

# --- Tuning ------------------------------------------------------------------
# LAKEHOUSE_SEGMENT_ROWS=2000               # events per sealed segment (one export batch)
# LAKEHOUSE_REORDER_WINDOW_MS=2000          # event-time reorder window in the ingest hub
# LAKEHOUSE_QUEUE_CAP_BYTES=536870912       # backpressure: max bytes waiting to upload
# LAKEHOUSE_UPLOAD_WORKERS=4                # parallel upload workers (leased)
# LAKEHOUSE_RETRY_BASE_SECONDS=1            # first retry delay; doubles per attempt
# LAKEHOUSE_HOT_SECONDS=0                   # keep local copies this long after remote proof
